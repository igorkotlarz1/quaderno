# Copy to .env and fill in. Never commit .env.
# Used from M2 (server) and M4 (Claude API).

# Postgres (M2)
POSTGRES_USER=quaderno
POSTGRES_PASSWORD=
POSTGRES_DB=quaderno

# Claude API (M4)
ANTHROPIC_API_KEY=

# Off-site backups with restic to Backblaze B2 (M2)
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
