# Copy to .env and fill in. Never commit .env.
# Used from M2 (server) and M4 (Claude API).

# Postgres (M2)
POSTGRES_USER=quaderno
POSTGRES_PASSWORD=
POSTGRES_DB=quaderno

# Claude API (M4). Empty = the app shows only the manual "copy the prompt" flow.
ANTHROPIC_API_KEY=
# Optional: other models than the defaults (Haiku 5.5 for lessons, Sonnet 5.5 for the weekly level)
# LLM_LESSON_MODEL=claude-haiku-5-5
# LLM_WEEK_MODEL=claude-sonnet-5-5

# Off-site backups with restic to Backblaze B2 (M2)
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
